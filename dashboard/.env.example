# Copy to .env and fill in. Required for Prisma (migrate, seed, Next.js).
# DATABASE_URL must point at a running Postgres (e.g. Docker postgres from docker-compose).

DATABASE_URL="postgresql://dccortex:dccortex_dev@localhost:5432/dccortex_dashboard"

# Optional: NextAuth (for login)
NEXTAUTH_URL="http://localhost:3000"
# ⚠️  MUST be a long random secret in production (e.g. `openssl rand -hex 32`).
# Exposing this lets anyone forge valid session tokens.
NEXTAUTH_SECRET="change-me-in-production"

# Optional: Platform API (dashboard talks to this)
PLATFORM_API_URL="http://localhost:3001"
NEXT_PUBLIC_PLATFORM_API_URL="http://localhost:3001"

# Optional: OAuth (Google/GitHub)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Required: Cortex AI (get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Email (SMTP for magic-link / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DCCortex <noreply@dccortex.com>"

# Optional: Internal API key (for platform-api communication)
# INTERNAL_API_KEY=change-me-in-production
